const express = require('express');
const path = require('path');
const app = express();
const PORT = process.env.PORT || 5500;

// Middleware to parse incoming JSON bodies
app.use(express.json());

// Serve static files (HTML, CSS, JS) from the root or public folder
app.use(express.static(__dirname));

// In-memory data store & auto-increment ID counter
let tasks = [
    { id: 1, title: 'Learn HTML & CSS' },
    { id: 2, title: 'Build a Node.js Backend' }
];
let nextId = 3;

// Serve static frontend root
app.get('/', (req, res) => {
    res.sendFile(path.join(__dirname, 'index.html'));
});

// GET endpoint (Read all tasks)
app.get('/api/tasks', (req, res) => {
    res.json(tasks);
});

// POST endpoint (Create a task)
app.post('/api/tasks', (req, res) => {
    const { title } = req.body;

    // 1. Input validation
    if (!title || typeof title !== 'string' || !title.trim()) {
        return res.status(400).json({ error: 'Task title is required.' });
    }

    // 2. Safe unique ID assignment
    const newTask = {
        id: nextId++,
        title: title.trim()
    };

    tasks.push(newTask);
    res.status(201).json(newTask);
});

// Start server
app.listen(PORT, () => {
    console.log(`Server running at http://localhost:${PORT}`);
});